# Copy to .env.development.local (gitignored, dev-mode only — never loaded
# during `pnpm build`/`pnpm zip`) and fill in one or more Cloudflare API
# tokens to skip re-pasting them into the extension after every `pnpm dev`
# reload. Comma-separated for more than one (e.g. to test account
# switching). Only seeded when chrome.storage.local has no token saved yet
# — see entrypoints/background/dev-token-seed.ts.
WXT_DEV_CF_API_TOKENS=
